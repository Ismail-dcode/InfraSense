# ==============================================================================
# InfraSense Environment Configuration & Credential Rotation Template
# ==============================================================================
# Security Notice:
# 1. Never commit `.env` containing real credentials to version control.
# 2. To rotate MongoDB credentials:
#    - Update the user password in MongoDB Atlas Console -> Database Access
#    - Replace `<db_password>` below in MONGODB_URI with your new password
#    - Restart the backend server (`npm run dev`)
# 3. To rotate JWT Secret:
#    - Generate a secure random string (e.g. `openssl rand -base64 32`)
#    - Update JWT_SECRET below. Note: Rotating JWT_SECRET will invalidate existing sessions.
# ==============================================================================

# Server Port
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# MongoDB Atlas Connection URI
# Replace <db_password> with your actual database user password
MONGODB_URI=mongodb+srv://royalismail6263_db_user:<db_password>@my-db1.wgv0rns.mongodb.net/infrasense?retryWrites=true&w=majority&appName=My-db1

# JWT Configuration
JWT_SECRET=infrasense_jwt_secure_super_secret_key_change_me_or_rotate
JWT_EXPIRES_IN=7d

# Frontend Application Client URL
CLIENT_URL=http://localhost:3000
